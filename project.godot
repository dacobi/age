; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://Audio"
SoftwareFormat/sample_rate=48000
SoftwareFormat/speaker_mode=3
SoftwareFormat/raw_speakers_count=0
DSP_Buffer/buffer_length=512
DSP_Buffer/num_buffers=4
Channels/channel_count=1024
Initialization/live_update=true

[application]

config/name="GCG Godot Engine"
run/main_scene="res://test_scene.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

ImGuiRoot="*res://addons/imgui-godot/data/ImGuiRoot.tscn"

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg", "res://addons/imgui-godot/plugin.cfg")

[rendering]

viewport/transparent_background=false
